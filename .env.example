# ---- Hostname and reverse proxy ----
# Hostnames the server answers to (besides localhost and IPs), comma-separated; Vite blocks other Host headers.
# APP_HOSTNAMES="security-analytics.cloudstaff.tech"
# IPs of the reverse proxy in front of the app; only their X-Forwarded-For / X-Forwarded-Proto are trusted
# (real client IP for the login rate limit, https for Secure cookies).
# TRUST_PROXY="10.69.100.1"   (the address the app actually sees the proxy connect from)

# ---- Sign-in: two options on the sign-in page ----
# Classic login (shared team account, checked on the server, always admin). On by default with the built-in account.
# Optional: your own classic credentials instead of the built-in account.
# AUTH_CLASSIC_USERNAME=""
# AUTH_CLASSIC_PASSWORD=""
# AUTH_CLASSIC_LOGIN=0   turns classic login off
#
# Sign in with Microsoft: enabled when all four are set and valid (otherwise its button is disabled)
# From the Entra ID app registration (see auth/auth.js). Users/groups must be assigned to the app in Entra.
# The redirect URI must be registered exactly; Microsoft only allows http:// for localhost, so servers need https.
AUTH_TENANT_ID=""
AUTH_CLIENT_ID=""
AUTH_CLIENT_SECRET=""
AUTH_REDIRECT_URI="https://your-server/auth/callback"   # path /auth/callback or /callback
# Always admin (comma-separated). They can't be demoted or removed from the app, so there is always an admin.
# Everyone else who signs in starts as "user"; admins change roles on the Users & Roles page.
AUTH_ADMIN_EMAILS="admin@your-company.com"
# With AUTH_DEV_BYPASS, act as "user" instead of "admin" to see what users see.
# AUTH_DEV_ROLE=user
# Local development only, when the four settings above are empty: requests from this machine are signed in as
# "Local developer". Never set this on a server.
# AUTH_DEV_BYPASS=1

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Jira datasource integration (optional)
# If configured, the app auto-loads Jira issues from your filter/JQL on startup
# (only when local saved data is empty).
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="your-email@company.com"
JIRA_API_TOKEN="your-jira-api-token"

# Provide one of these:
JIRA_FILTER_ID=""
JIRA_JQL=""

# Optional: custom fields used in your Jira instance.
# Examples: customfield_12345
# Defaults in code:
# - JIRA_SEVERITY_FIELD defaults to customfield_10072
# - JIRA_SECURITY_DUE_DATE_FIELD defaults to customfield_10102
# - JIRA_SECURITY_TYPE_FIELD defaults to customfield_10086
JIRA_SEVERITY_FIELD="customfield_10072"
JIRA_SECURITY_DUE_DATE_FIELD="customfield_10102"
JIRA_SECURITY_TYPE_FIELD="customfield_10086"

# PostgreSQL persistence (optional but recommended for durable data)
# If these are set, the app stores issues in Postgres and loads them on startup.
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_USER="project_user"
DB_PASSWORD="project_password_change_me"
DB_NAME="project_analytics"

# Docker postgres bootstrap values (used by docker-compose)
POSTGRES_DB="project_analytics"
POSTGRES_USER="project_user"
POSTGRES_PASSWORD="project_password_change_me"

# ---- UberTicket monitoring (/dpsa, /full-assessment, /rules-of-engagement tabs) ----
# The UberTicket token is set in the app: open a monitoring tab -> Settings and paste the token
# (you must be signed in with Microsoft). It is stored encrypted in monitor/data/.
# Optional overrides (defaults shown)
# DPSA_TEMPLATES=322255:Staging,1113577:UAT
# FULL_TEMPLATE=1080829
# ROE_TEMPLATE=72913
# MTTR_TARGET_DAYS=3
# SLA_LOW_DAYS=5
# SLA_MEDIUM_DAYS=10
# SLA_HIGH_DAYS=15
# SLA_CRITICAL_DAYS=20
# REFRESH_MINUTES=5
# Archived UberTicket tickets are included; set to 0 to leave them out
# INCLUDE_ARCHIVED=1
