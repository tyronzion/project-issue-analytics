# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Jira datasource integration (optional)
# If configured, the app auto-loads Jira issues from your filter/JQL on startup
# (only when local saved data is empty).
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="your-email@company.com"
JIRA_API_TOKEN="your-jira-api-token"

# Provide one of these:
JIRA_FILTER_ID=""
JIRA_JQL=""

# Optional: custom fields used in your Jira instance.
# Examples: customfield_12345
# Defaults in code:
# - JIRA_SEVERITY_FIELD defaults to customfield_10072
# - JIRA_SECURITY_DUE_DATE_FIELD defaults to customfield_10102
# - JIRA_SECURITY_TYPE_FIELD defaults to customfield_10086
JIRA_SEVERITY_FIELD="customfield_10072"
JIRA_SECURITY_DUE_DATE_FIELD="customfield_10102"
JIRA_SECURITY_TYPE_FIELD="customfield_10086"
